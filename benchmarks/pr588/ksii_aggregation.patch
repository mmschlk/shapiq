+def _is_zero(value: float | np.ndarray) -> bool:
+    """Whether an aggregation term is (entirely) zero.
+
+    ``np.all(value == 0)`` would be the one-liner, but the aggregation loop runs it twice per
+    projected subset and the values are Python floats on every single-instance explanation, so
+    it costs a full numpy reduction dispatch (~4 us) per scalar comparison -- thousands of them
+    per explanation. Only the batched path, where values are one array per explained instance,
+    needs numpy at all.
+    """
+    return not value.any() if isinstance(value, np.ndarray) else value == 0
